diff --git a/lib/streamaggr/reset_marker_test.go b/lib/streamaggr/reset_marker_test.go
new file mode 100644
index 000000000..788e1649d
--- /dev/null
+++ b/lib/streamaggr/reset_marker_test.go
@@ -0,0 +1,281 @@
+package streamaggr
+
+import (
+	"sort"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/prompb"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/protoparser/prometheus"
+)
+
+type pushAt struct {
+	at      time.Duration
+	metrics string
+}
+
+type markerSample struct {
+	at    time.Duration // offset from the start of the scenario
+	value float64
+}
+
+// runStaleScenario pushes the given metrics at the given offsets on a fake clock and returns output samples per metric name,
+// ordered by timestamp.
+//
+// How many flushes an alive period produces depends on goroutine scheduling around interval boundaries,
+// so the assertions below check the shape of the output instead of exact sample counts.
+// Samples at or after settledBefore are dropped when settledBefore > 0, since the final flush at shutdown isn't deterministic.
+func runStaleScenario(t *testing.T, config string, pushes []pushAt, until, settledBefore time.Duration) map[string][]markerSample {
+	t.Helper()
+	out := map[string][]markerSample{}
+	synctest.Test(t, func(t *testing.T) {
+		var mu sync.Mutex
+		var tss []prompb.TimeSeries
+		pushFunc := func(src []prompb.TimeSeries) {
+			mu.Lock()
+			tss = appendClonedTimeseries(tss, src)
+			mu.Unlock()
+		}
+		a, err := LoadFromData([]byte(config), pushFunc, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		start := time.Now()
+		for _, p := range pushes {
+			time.Sleep(start.Add(p.at).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(p.metrics, time.Now().UnixMilli()), nil)
+		}
+		time.Sleep(start.Add(until).Sub(time.Now()))
+		a.MustStop()
+
+		mu.Lock()
+		defer mu.Unlock()
+		for _, ts := range tss {
+			name := ""
+			for _, l := range ts.Labels {
+				if l.Name == "__name__" {
+					name = l.Value
+				}
+			}
+			for _, s := range ts.Samples {
+				at := time.UnixMilli(s.Timestamp).Sub(start)
+				if settledBefore > 0 && at >= settledBefore {
+					continue
+				}
+				out[name] = append(out[name], markerSample{at, s.Value})
+			}
+		}
+		for name := range out {
+			sort.SliceStable(out[name], func(i, j int) bool { return out[name][i].at < out[name][j].at })
+		}
+	})
+	return out
+}
+
+// collapse removes consecutive duplicate values.
+func collapse(samples []markerSample) []float64 {
+	var vs []float64
+	for _, s := range samples {
+		if n := len(vs); n == 0 || vs[n-1] != s.value {
+			vs = append(vs, s.value)
+		}
+	}
+	return vs
+}
+
+func equalFloats(a, b []float64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// Two alive periods of the same counter with a gap longer than staleness_interval between them.
+// The scrape target deleted the idle counter and recreated it from zero, so the second period reaches 5 again.
+var twoPeriods = []pushAt{
+	{0, `foo{pod="a"} 5`},
+	{10 * time.Minute, `foo{pod="b"} 5`},
+}
+
+func markerConfig(outputs string, keepMetricNames, marker bool) string {
+	s := `
+- interval: 1m
+  staleness_interval: 2m
+  ignore_first_sample_interval: 0s
+  without: [pod]
+  outputs: ` + outputs + "\n"
+	if keepMetricNames {
+		s += "  keep_metric_names: true\n"
+	}
+	if marker {
+		s += "  reset_marker_on_stale: true\n"
+	}
+	return s
+}
+
+// Without a marker the output is 5 → gap → 5, so increase() over the gap is 0 while the real increase is 5.
+// With the marker a zero sample is emitted right after each alive period and one interval before each one,
+// which makes the reset explicit.
+func TestResetMarkerOnStale(t *testing.T) {
+	without := runStaleScenario(t, markerConfig("[total]", true, false), twoPeriods, 20*time.Minute, 18*time.Minute)["foo"]
+	if got := collapse(without); !equalFloats(got, []float64{5}) {
+		t.Fatalf("without marker the output must never drop to zero; got %v", without)
+	}
+
+	with := runStaleScenario(t, markerConfig("[total]", true, true), twoPeriods, 20*time.Minute, 18*time.Minute)["foo"]
+	if got := collapse(with); !equalFloats(got, []float64{0, 5, 0, 5, 0}) {
+		t.Fatalf("with marker: got %v; want the shape [0 5 0 5 0]", with)
+	}
+	for i, s := range with {
+		if s.value != 0 {
+			continue
+		}
+		leading := i+1 < len(with) && with[i+1].value == 5 && with[i+1].at-s.at == time.Minute
+		trailing := i > 0 && with[i-1].value == 5 && s.at-with[i-1].at == time.Minute
+		if leading == trailing {
+			t.Fatalf("a marker must either precede the first flush or follow the last flush of an alive period by one interval; got %v", with)
+		}
+		if trailing && i+1 < len(with) && with[i+1].at < 10*time.Minute-time.Minute {
+			t.Fatalf("nothing must be emitted during the gap after a marker; got %v", with)
+		}
+	}
+}
+
+// vmagent restart (or crash) drops the aggregation state without any marker: the output ends at 1, and after the restart
+// a new low-frequency request makes it 1 again. Without the leading zero increase() over both sees no reset.
+//
+// ignore_first_sample_interval is 0s: lib/fasttime reads the real clock outside of goexperiment.synctest builds,
+// so the interval can't elapse on the fake clock. It doesn't take part in the problem anyway.
+func TestResetMarkerOnRestart(t *testing.T) {
+	const config = `
+- interval: 1m
+  staleness_interval: 2m
+  ignore_first_sample_interval: 0s
+  without: [pod]
+  outputs: [total]
+  keep_metric_names: true
+`
+	for _, c := range []struct {
+		marker bool
+		want   float64
+	}{{false, 1}, {true, 2}} {
+		cfg := config
+		if c.marker {
+			cfg += "  reset_marker_on_stale: true\n"
+		}
+		synctest.Test(t, func(t *testing.T) {
+			var mu sync.Mutex
+			var tss []prompb.TimeSeries
+			pushFunc := func(src []prompb.TimeSeries) {
+				mu.Lock()
+				tss = appendClonedTimeseries(tss, src)
+				mu.Unlock()
+			}
+			start := time.Now()
+			a, err := LoadFromData([]byte(cfg), pushFunc, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			time.Sleep(30 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(`foo{pod="a"} 1`, time.Now().UnixMilli()), nil)
+			time.Sleep(90 * time.Second)
+			a.MustStop() // restart while the output is alive
+			time.Sleep(30 * time.Second)
+			b, err := LoadFromData([]byte(cfg), pushFunc, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			time.Sleep(10 * time.Minute)
+			b.Push(prometheus.MustParsePromMetrics(`foo{pod="b"} 1`, time.Now().UnixMilli()), nil)
+			time.Sleep(90 * time.Second)
+			b.MustStop()
+
+			mu.Lock()
+			defer mu.Unlock()
+			var out []markerSample
+			for _, ts := range tss {
+				for _, s := range ts.Samples {
+					out = append(out, markerSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+				}
+			}
+			sort.SliceStable(out, func(i, j int) bool { return out[i].at < out[j].at })
+			if got := increasePure(out); got != c.want {
+				t.Fatalf("marker=%v: want increase %v; got %v from %v", c.marker, c.want, got, out)
+			}
+		})
+	}
+}
+
+// The marker is emitted only for cumulative total outputs; increase output isn't affected.
+//
+// total and increase are flushed together, so within the same run increase must have exactly the flushes of total
+// except the markers. (Comparing two separate runs isn't reliable: the number of flushes per alive period depends on scheduling.)
+func TestResetMarkerOnStaleOnlyCumulativeTotal(t *testing.T) {
+	const total, increase = "foo:1m_without_pod_total", "foo:1m_without_pod_increase"
+	for range 5 {
+		out := runStaleScenario(t, markerConfig("[total, increase]", false, true), twoPeriods, 20*time.Minute, 18*time.Minute)
+		if got := collapse(out[total]); !equalFloats(got, []float64{0, 5, 0, 5, 0}) {
+			t.Fatalf("total output: got %v; want the shape [0 5 0 5 0]", out[total])
+		}
+		var totalFlushes []time.Duration
+		for _, s := range out[total] {
+			if s.value != 0 {
+				totalFlushes = append(totalFlushes, s.at)
+			}
+		}
+		if len(out[increase]) != len(totalFlushes) {
+			t.Fatalf("increase output must have the flushes of total without markers; total %v; increase %v", out[total], out[increase])
+		}
+		for i, s := range out[increase] {
+			if s.at != totalFlushes[i] {
+				t.Fatalf("increase output must have the flushes of total without markers; total %v; increase %v", out[total], out[increase])
+			}
+		}
+	}
+}
+
+// No marker is emitted at shutdown for series which are still alive.
+// flush_on_shutdown is needed to observe the final flush at all: by default its output is dropped.
+func TestResetMarkerOnStaleNotOnShutdown(t *testing.T) {
+	config := markerConfig("[total]", true, true) + "  flush_on_shutdown: true\n"
+	for range 5 {
+		// Stop 90 seconds after the second push, while the series is still alive.
+		// (A leading zero before the second alive period is expected; only the tail matters here.)
+		alive := runStaleScenario(t, config, twoPeriods, 11*time.Minute+30*time.Second, 0)["foo"]
+		if n := len(alive); n == 0 || alive[n-1].value != 5 {
+			t.Fatalf("no marker is expected at shutdown for alive series; got %v", alive)
+		}
+	}
+}
+
+func TestResetMarkerOnStaleRequiresCumulativeTotal(t *testing.T) {
+	for _, outputs := range []string{"[increase]", "[increase_prometheus]", "[sum_samples]"} {
+		config := `
+- interval: 1m
+  outputs: ` + outputs + `
+  reset_marker_on_stale: true
+`
+		if _, err := LoadFromData([]byte(config), func([]prompb.TimeSeries) {}, nil, "test"); err == nil {
+			t.Fatalf("expecting an error for outputs %s", outputs)
+		}
+	}
+	for _, outputs := range []string{"[total]", "[total_prometheus]", "[increase, total]", "[sum_samples_total]"} {
+		config := `
+- interval: 1m
+  outputs: ` + outputs + `
+  reset_marker_on_stale: true
+`
+		a, err := LoadFromData([]byte(config), func([]prompb.TimeSeries) {}, nil, "test")
+		if err != nil {
+			t.Fatalf("unexpected error for outputs %s: %s", outputs, err)
+		}
+		a.MustStop()
+	}
+}
diff --git a/lib/streamaggr/restart_collision_test.go b/lib/streamaggr/restart_collision_test.go
new file mode 100644
index 000000000..db2faecaf
--- /dev/null
+++ b/lib/streamaggr/restart_collision_test.go
@@ -0,0 +1,79 @@
+package streamaggr
+
+import (
+	"sort"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/prompb"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/protoparser/prometheus"
+)
+
+// The leading zero of a new output lands one interval before its first flush, which is close to
+// where the process that died may have flushed a real value. Two samples of the same series at the
+// same timestamp are resolved by keeping the larger one, which would swallow the zero and hide the
+// reset, so they must never collide.
+//
+// They cannot: the first incomplete interval after a start is not flushed, which leaves at least one
+// interval between the last flush of the old process and the leading zero of the new one. This pins
+// that down with the tightest restart there is, one that lives through a boundary and comes back
+// within the same interval.
+func TestLeadingZeroAfterShortRestart(t *testing.T) {
+	const config = `
+- interval: 1m
+  staleness_interval: 5m
+  ignore_first_sample_interval: 0s
+  without: [pod]
+  outputs: [total]
+  keep_metric_names: true
+  reset_marker_on_stale: true
+`
+	synctest.Test(t, func(t *testing.T) {
+		var mu sync.Mutex
+		var tss []prompb.TimeSeries
+		pushFunc := func(src []prompb.TimeSeries) {
+			mu.Lock()
+			tss = appendClonedTimeseries(tss, src)
+			mu.Unlock()
+		}
+		start := time.Now()
+		a, err := LoadFromData([]byte(config), pushFunc, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		time.Sleep(10 * time.Second)
+		a.Push(prometheus.MustParsePromMetrics(`foo{pod="a"} 5`, time.Now().UnixMilli()), nil)
+		time.Sleep(175 * time.Second) // live through the 180s boundary, then die just after it
+		a.MustStop()
+
+		time.Sleep(5 * time.Second) // a short restart, well under one interval
+		b, err := LoadFromData([]byte(config), pushFunc, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		b.Push(prometheus.MustParsePromMetrics(`foo{pod="b"} 5`, time.Now().UnixMilli()), nil)
+		time.Sleep(150 * time.Second)
+		b.MustStop()
+
+		mu.Lock()
+		defer mu.Unlock()
+		var out []markerSample
+		for _, ts := range tss {
+			for _, s := range ts.Samples {
+				out = append(out, markerSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+			}
+		}
+		sort.SliceStable(out, func(i, j int) bool { return out[i].at < out[j].at })
+		t.Logf("samples: %v", out)
+
+		// look for two samples of the same series at the same timestamp with different values
+		for i := 1; i < len(out); i++ {
+			if out[i].at == out[i-1].at && out[i].value != out[i-1].value {
+				t.Fatalf("two values at the same timestamp %v: %v and %v; the smaller one is dropped by deduplication: %v",
+					out[i].at, out[i-1].value, out[i].value, out)
+			}
+		}
+	})
+}
diff --git a/lib/streamaggr/sample_timestamps_rules_test.go b/lib/streamaggr/sample_timestamps_rules_test.go
new file mode 100644
index 000000000..f4159f1eb
--- /dev/null
+++ b/lib/streamaggr/sample_timestamps_rules_test.go
@@ -0,0 +1,941 @@
+package streamaggr
+
+import (
+	"fmt"
+	"math/rand"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/prompb"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/protoparser/prometheus"
+)
+
+// The rules of sample_timestamps, as these tests check them. A sample belongs
+// to the interval [end - interval, end) its scrape timestamp falls in, and is
+// written at the end of it:
+//
+//   - processed before that interval is written, it is written with it;
+//   - processed after, while it is still the interval written last, it is the
+//     tail of a round that crossed the boundary: the interval is written again,
+//     at the same timestamp, complete, and VM keeps the bigger value;
+//   - processed later than that, it goes to the first interval not written.
+//
+// Either way every sample is counted once, and the samples of one round -- one
+// push here -- go to the same interval in every output.
+
+// tokensCost is a round of usage: tokens, and cost three times as much.
+func tokensCost(v float64) string { return fmt.Sprintf("tokens %v\ncost %v", v, 3*v) }
+
+func stConfig(output string, extra string) string {
+	return "- match: '{__name__=~\"tokens|cost\"}'\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+		"  staleness_interval: 40m\n  sample_timestamps: true\n" + extra
+}
+
+// perInterval is what an output wrote for the interval ending at to: the sum
+// of its samples for sum_samples, the increase for sum_samples_total.
+func perInterval(output string, samples []outSample, to, iv time.Duration) float64 {
+	if output == "sum_samples" {
+		return sumIn(samples, to-iv, to)
+	}
+	return increaseIn(samples, to-iv, to)
+}
+
+// checkMinutes checks tokens per minute against want, and that cost is three
+// times the tokens in every minute: the samples of a round were not split.
+func checkMinutes(t *testing.T, output string, got map[string][]outSample, want map[int]float64, minutes int) {
+	t.Helper()
+	for m := 1; m <= minutes; m++ {
+		to := time.Duration(m) * time.Minute
+		tok, cost := perInterval(output, got["tokens"], to, time.Minute), perInterval(output, got["cost"], to, time.Minute)
+		if tok != want[m] {
+			t.Errorf("%s: minute ending %dm has tokens %v, want %v; tokens %v", output, m, tok, want[m], got["tokens"])
+		}
+		if cost != 3*tok {
+			t.Errorf("%s: minute ending %dm has tokens %v but cost %v: a round was split; cost %v", output, m, tok, cost, got["cost"])
+		}
+	}
+}
+
+var stOutputs = []string{"sum_samples", "sum_samples_total"}
+
+// Rounds processed within their interval are written with it, once per
+// interval however many targets feed it.
+func TestSampleTimestampsOnTimeRoundsGoToTheirInterval(t *testing.T) {
+	for _, output := range stOutputs {
+		var pushes []latePush
+		for m := 0; m < 3; m++ {
+			for _, off := range []time.Duration{5 * time.Second, 23 * time.Second, 41 * time.Second} {
+				at := time.Duration(m)*time.Minute + off
+				pushes = append(pushes, latePush{at: at + 2*time.Second, sampleAt: at, metrics: tokensCost(1)})
+			}
+		}
+		got := runLateScenario(t, stConfig(output, ""), pushes, 5*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{1: 3, 2: 3, 3: 3}, 5)
+		for _, s := range got["tokens"] {
+			if s.at%time.Minute != 0 {
+				t.Errorf("%s: sample %v is not at the end of a minute", output, s)
+			}
+		}
+		if output == "sum_samples" && len(got["tokens"]) != 3 {
+			t.Errorf("%s: want one sample per minute, 3 in all; got %v", output, got["tokens"])
+		}
+	}
+}
+
+// A round scraped right on a boundary, as scrape_align_interval has them,
+// belongs to the interval that starts there; one scraped a millisecond before
+// it, to the one that ends there.
+func TestSampleTimestampsBoundaryBelongsToTheIntervalItStarts(t *testing.T) {
+	for _, output := range stOutputs {
+		got := runLateScenario(t, stConfig(output, ""), []latePush{
+			{at: 2*time.Minute - time.Millisecond, sampleAt: 2*time.Minute - time.Millisecond, metrics: tokensCost(1)},
+			{at: 2*time.Minute + 10*time.Second, sampleAt: 2 * time.Minute, metrics: tokensCost(5)},
+		}, 4*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{2: 1, 3: 5}, 4)
+	}
+}
+
+// The tail of a round that crossed the boundary -- processed after its interval
+// was written, before the next one was -- completes that interval: it is written
+// again at the same timestamp, with the whole round.
+func TestSampleTimestampsTailCompletesTheIntervalWrittenLast(t *testing.T) {
+	for _, output := range stOutputs {
+		got := runLateScenario(t, stConfig(output, ""), []latePush{
+			{at: 90 * time.Second, sampleAt: 80 * time.Second, metrics: tokensCost(4)},
+			{at: 2*time.Minute + 10*time.Second, sampleAt: 80 * time.Second, metrics: tokensCost(6)},
+		}, 4*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{2: 10, 3: 0}, 4)
+		n := 0
+		for _, s := range got["tokens"] {
+			if s.at == 2*time.Minute {
+				n++
+			}
+		}
+		if n != 2 {
+			t.Errorf("%s: want the minute ending 2m written twice, the second time complete; tokens %v", output, got["tokens"])
+		}
+	}
+}
+
+// A tail that would make the interval smaller cannot complete it -- VM keeps the
+// bigger of two values at one timestamp -- so it goes to the next interval.
+func TestSampleTimestampsNegativeTailGoesToTheNextInterval(t *testing.T) {
+	got := runLateScenario(t, stConfig("sum_samples", ""), []latePush{
+		{at: 90 * time.Second, sampleAt: 80 * time.Second, metrics: `tokens 4`},
+		{at: 2*time.Minute + 10*time.Second, sampleAt: 80 * time.Second, metrics: `tokens -1`},
+	}, 4*time.Minute)["tokens"]
+	if a, b := sumIn(got, time.Minute, 2*time.Minute), sumIn(got, 2*time.Minute, 3*time.Minute); a != 4 || b != -1 {
+		t.Fatalf("want 4 in the minute ending 2m and -1 in the next; got %v and %v: %v", a, b, got)
+	}
+}
+
+// Rounds whose interval has ended by the time they are processed go to the
+// interval they are processed in, all of them together. Nothing is lost,
+// nothing counted twice.
+func TestSampleTimestampsLateRoundsGoToTheFirstIntervalNotWritten(t *testing.T) {
+	for _, output := range stOutputs {
+		got := runLateScenario(t, stConfig(output, ""), []latePush{
+			// scraped in the minutes ending 2m to 5m, all processed at 5m10s
+			{at: 5*time.Minute + 10*time.Second, sampleAt: 1 * time.Minute, metrics: tokensCost(1)},
+			{at: 5*time.Minute + 10*time.Second, sampleAt: 2 * time.Minute, metrics: tokensCost(2)},
+			{at: 5*time.Minute + 10*time.Second, sampleAt: 3 * time.Minute, metrics: tokensCost(3)},
+			{at: 5*time.Minute + 10*time.Second, sampleAt: 4 * time.Minute, metrics: tokensCost(4)},
+			// another target's, scraped in the minute ending 3m, processed at 6m10s
+			{at: 6*time.Minute + 10*time.Second, sampleAt: 2*time.Minute + 7*time.Second, metrics: tokensCost(20)},
+		}, 8*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{6: 1 + 2 + 3 + 4, 7: 20}, 8)
+	}
+}
+
+// The rest of a late round processed after the flush of the interval it was
+// put in goes there too, as that interval's tail: samples sharing a scrape
+// timestamp are taken as one round, whose interval is decided at the first.
+func TestSampleTimestampsLateRoundKeepsItsInterval(t *testing.T) {
+	for _, output := range stOutputs {
+		got := runLateScenario(t, stConfig(output, ""), []latePush{
+			{at: 5*time.Minute + 10*time.Second, sampleAt: 2 * time.Minute, metrics: tokensCost(2)},
+			{at: 6*time.Minute + 10*time.Second, sampleAt: 2 * time.Minute, metrics: tokensCost(20)},
+		}, 8*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{6: 22}, 8)
+	}
+}
+
+// Rounds scraped before the aggregator started go to the first interval it
+// writes: the one before is the previous process's, which may have written it.
+func TestSampleTimestampsRoundsBeforeTheStartGoToTheFirstInterval(t *testing.T) {
+	for _, output := range stOutputs {
+		got := runLateScenario(t, stConfig(output, ""), []latePush{
+			{at: 10 * time.Second, sampleAt: -30 * time.Second, metrics: tokensCost(7)},
+		}, 3*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{1: 7}, 3)
+		for _, s := range got["tokens"] {
+			if s.at <= 0 && s.value != 0 {
+				t.Errorf("%s: %v written at or before the start", output, s)
+			}
+		}
+	}
+}
+
+// A sample stamped ahead of the clock counts as processed now; held until its
+// time came, it would keep its output from being dropped as stale.
+func TestSampleTimestampsFutureTimestampCountsNow(t *testing.T) {
+	got := runLateScenario(t, stConfig("sum_samples", "  flush_on_shutdown: true\n"), []latePush{
+		{at: 10 * time.Second, sampleAt: 2*time.Minute + 30*time.Second, metrics: `tokens 5`},
+	}, 4*time.Minute)["tokens"]
+	if sumIn(got, 0, time.Minute) != 5 || len(got) != 1 {
+		t.Fatalf("want 5 written once in the minute ending 1m; got %v", got)
+	}
+}
+
+// sum_samples_total never goes back, puts the reset marker before its first
+// sample, and its heartbeat does not get ahead of the intervals written.
+func TestSampleTimestampsTotalStaysACounter(t *testing.T) {
+	cfg := stConfig("sum_samples_total", "  output_heartbeat_interval: 4m\n  reset_marker_on_stale: true\n")
+	pushes := []latePush{{at: 30 * time.Second, sampleAt: 0, metrics: tokensCost(1)}}
+	for i := 1; i <= 11; i++ {
+		pushes = append(pushes, latePush{at: 12*time.Minute + 5*time.Second, sampleAt: time.Duration(i) * time.Minute, metrics: tokensCost(1)})
+	}
+	got := runLateScenario(t, cfg, pushes, 14*time.Minute)
+	tok := got["tokens"]
+	if len(tok) == 0 || tok[0].value != 0 {
+		t.Fatalf("want the reset marker first; got %v", tok)
+	}
+	for i := 1; i < len(tok); i++ {
+		if tok[i].value < tok[i-1].value {
+			t.Fatalf("the counter goes back from %v to %v: %v", tok[i-1], tok[i], tok)
+		}
+	}
+	// the eleven rounds' minutes have all ended: they go to the one they are processed in
+	checkMinutes(t, "sum_samples_total", got, map[int]float64{1: 1, 13: 11}, 14)
+}
+
+// However far behind the aggregator is, an output holds only a few sums: the
+// samples of intervals before the one written last go to the first one not
+// written. What is left is that one, the tail of the one written last and, for
+// sum_samples, what was written for it, and the next one.
+func TestSampleTimestampsPendingStaysBounded(t *testing.T) {
+	for _, output := range stOutputs {
+		synctest.Test(t, func(t *testing.T) {
+			a, err := LoadFromData([]byte(stConfig(output, "")), func([]prompb.TimeSeries) {}, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			defer a.MustStop()
+			start := time.Now()
+			time.Sleep(30*time.Minute + 10*time.Second)
+			// a round of every minute so far, all processed now, and one of now
+			for m := 0; m <= 30; m++ {
+				a.Push(prometheus.MustParsePromMetrics(tokensCost(1), start.Add(time.Duration(m)*time.Minute+time.Second).UnixMilli()), nil)
+			}
+			for i := range a.as[0].aggrOutputs.shards {
+				sh := &a.as[0].aggrOutputs.shards[i]
+				sh.mu.RLock()
+				for k, av := range sh.m {
+					var p *bySampleTime
+					switch v := av.one[0].(type) {
+					case *sumSamplesAtValue:
+						p = &v.pending
+					case *sumSamplesTotalAtValue:
+						p = &v.pending
+					}
+					if n := len(p.take(nil)); n > 4 {
+						t.Errorf("%s: output %q holds %d sums", output, k, n)
+					}
+				}
+				sh.mu.RUnlock()
+			}
+		})
+	}
+}
+
+// Every sample is counted exactly once, a round's samples always go to the same
+// interval, and each goes where the rules put it: rounds from targets scraped
+// at offsets of their own, some right on a boundary, processed up to two and a
+// half minutes late.
+//
+// Without flushes taking longer than their interval, where a sample goes follows
+// from when it was processed alone, and every interval is checked against that.
+// With them -- the flush holding up the next one -- it depends on what the flush
+// had reached, and the intervals are checked for what holds regardless: a round
+// never split, no sample written before its interval, and everything counted.
+func TestSampleTimestampsRules(t *testing.T) {
+	for seed := int64(1); seed <= 20; seed++ {
+		for _, output := range stOutputs {
+			for _, iv := range []time.Duration{time.Minute, 7 * time.Minute} {
+				for _, overrun := range []bool{false, true} {
+					checkSampleTimestampsRules(t, seed, output, iv, overrun)
+				}
+			}
+		}
+	}
+}
+
+func checkSampleTimestampsRules(t *testing.T, seed int64, output string, iv time.Duration, overrun bool) {
+	t.Helper()
+	name := fmt.Sprintf("seed=%d output=%s interval=%s overrun=%v", seed, output, iv, overrun)
+	cfg := fmt.Sprintf("- match: '{__name__=~\"tokens|cost\"}'\n  interval: %s\n  outputs: [%s]\n  keep_metric_names: true\n"+
+		"  staleness_interval: 2h\n  flush_on_shutdown: true\n  sample_timestamps: true\n", iv, output)
+	rnd := rand.New(rand.NewSource(seed))
+	type push struct {
+		at, sampleAt time.Duration
+		value        float64
+	}
+	const minutes = 40
+	var pushes []push
+	offsets := []time.Duration{0, time.Millisecond, 13 * time.Second, 37 * time.Second, 59*time.Second + 999*time.Millisecond}
+	for m := 1; m < minutes; m++ {
+		for _, off := range offsets {
+			sampleAt := time.Duration(m)*time.Minute + off
+			delay := time.Duration(1+rnd.Intn(2000)) * time.Millisecond
+			if rnd.Intn(5) == 0 {
+				delay = time.Duration(rnd.Intn(150))*time.Second + time.Duration(1+rnd.Intn(999))*time.Millisecond
+			}
+			pushes = append(pushes, push{at: sampleAt + delay, sampleAt: sampleAt, value: float64(1 + rnd.Intn(9))})
+		}
+	}
+	sort.SliceStable(pushes, func(i, j int) bool { return pushes[i].at < pushes[j].at })
+	flushDelays := make([]time.Duration, 100)
+	for i := range flushDelays {
+		if overrun && rnd.Intn(4) == 0 {
+			flushDelays[i] = time.Duration(1+rnd.Intn(100)) * time.Second
+		}
+	}
+
+	got := map[string][]outSample{}
+	var start time.Time
+	var phase int64
+	synctest.Test(t, func(t *testing.T) {
+		start = time.Now()
+		var mu sync.Mutex
+		flushes := 0
+		pushFunc := func(tss []prompb.TimeSeries) {
+			mu.Lock()
+			for _, ts := range tss {
+				name := ""
+				for _, l := range ts.Labels {
+					if l.Name == "__name__" {
+						name = l.Value
+					}
+				}
+				for _, s := range ts.Samples {
+					got[name] = append(got[name], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+				}
+			}
+			d := flushDelays[flushes%len(flushDelays)]
+			flushes++
+			mu.Unlock()
+			time.Sleep(d)
+		}
+		a, err := LoadFromData([]byte(cfg), pushFunc, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		phase = a.as[0].intervalPhaseMsec
+		for _, p := range pushes {
+			time.Sleep(start.Add(p.at).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(p.value), start.Add(p.sampleAt).UnixMilli()), nil)
+		}
+		time.Sleep(start.Add(minutes*time.Minute + 5*time.Minute).Sub(time.Now()))
+		a.MustStop()
+	})
+	for k := range got {
+		sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+	}
+
+	// The flushes' grid, relative to the start: floor gives the boundary at or
+	// before at, end the end of the interval [end - iv, end) at falls in.
+	ivMs := iv.Milliseconds()
+	floor := func(at time.Duration) time.Duration {
+		abs := start.Add(at).UnixMilli()
+		d := abs - phase
+		q := d / ivMs
+		if d < 0 && d%ivMs != 0 {
+			q--
+		}
+		return time.UnixMilli(phase + q*ivMs).Sub(start)
+	}
+	end := func(at time.Duration) time.Duration { return floor(at) + iv }
+
+	var all float64
+	own := map[time.Duration]float64{} // by the interval each was scraped in
+	for _, p := range pushes {
+		all += p.value
+		own[end(p.sampleAt)] += p.value
+	}
+	ends := map[time.Duration]bool{}
+	for e := range own {
+		ends[e], ends[e+iv] = true, true
+	}
+	// the flush on shutdown waits for the one before, which a flush delay holds up
+	runEnd := minutes*time.Minute + 5*time.Minute
+	for _, d := range flushDelays {
+		runEnd = max(runEnd, minutes*time.Minute+5*time.Minute+d)
+	}
+	for _, s := range got["tokens"] {
+		ends[s.at] = true
+		if s.at > runEnd {
+			t.Fatalf("%s: sample %v is after the end of the run", name, s)
+		}
+	}
+
+	// Everything counted once, and a round never split: cost is three times the
+	// tokens over everything and in every interval.
+	total := func(samples []outSample) float64 {
+		if output == "sum_samples" {
+			return sumIn(samples, -time.Hour, 2*time.Hour)
+		}
+		return increaseIn(samples, -time.Hour, 2*time.Hour)
+	}
+	if tok, cost := total(got["tokens"]), total(got["cost"]); tok != all || cost != 3*all {
+		t.Errorf("%s: tokens %v, cost %v; want %v and %v", name, tok, cost, all, 3*all)
+	}
+	for e := range ends {
+		tok, cost := perInterval(output, got["tokens"], e, iv), perInterval(output, got["cost"], e, iv)
+		if cost != 3*tok {
+			t.Errorf("%s: interval ending %s has tokens %v but cost %v: a round was split", name, e, tok, cost)
+		}
+	}
+	if output == "sum_samples_total" {
+		for i := 1; i < len(got["tokens"]); i++ {
+			if got["tokens"][i].value < got["tokens"][i-1].value {
+				t.Fatalf("%s: the counter goes back from %v to %v", name, got["tokens"][i-1], got["tokens"][i])
+			}
+		}
+	}
+
+	// No sample is written before its interval: by the end of any interval, no
+	// more has been written than was scraped by then.
+	var sortedEnds []time.Duration
+	for e := range ends {
+		sortedEnds = append(sortedEnds, e)
+	}
+	sort.Slice(sortedEnds, func(i, j int) bool { return sortedEnds[i] < sortedEnds[j] })
+	for _, e := range sortedEnds {
+		var scraped float64
+		for oe, v := range own {
+			if oe <= e {
+				scraped += v
+			}
+		}
+		var written float64
+		if output == "sum_samples" {
+			written = sumIn(got["tokens"], -time.Hour, e)
+		} else {
+			written = increaseIn(got["tokens"], -time.Hour, e)
+		}
+		if written > scraped {
+			t.Errorf("%s: %v written by %s, but only %v scraped by then", name, written, e, scraped)
+		}
+	}
+	if overrun {
+		return
+	}
+
+	// Where each push goes, from when it was processed: its own interval if
+	// that has not ended by the boundary before, else the one it is processed in.
+	want := map[time.Duration]float64{}
+	for _, p := range pushes {
+		want[max(end(min(p.sampleAt, p.at)), floor(p.at)+iv)] += p.value
+	}
+	for e := range ends {
+		if g := perInterval(output, got["tokens"], e, iv); g != want[e] {
+			t.Errorf("%s: interval ending %s has %v, want %v (scraped in it: %v)", name, e, g, want[e], own[e])
+		}
+	}
+}
+
+// A round still being processed when a flush walks the outputs reaches some of
+// them before the flush does and some after: the ones reached after write it
+// with the interval, the others hold it as the tail of the interval written
+// last and write that again at the next flush. Either way the round is in the
+// same interval in every output -- for a round of the interval being written,
+// and for one processed late, whose interval is decided at its first sample.
+func TestSampleTimestampsRoundDuringTheFlushStaysTogether(t *testing.T) {
+	for _, c := range []struct {
+		name               string
+		scrapedAt, firstAt time.Duration
+		want               map[int]float64
+	}{
+		{"of the interval being written", 100 * time.Second, 110 * time.Second, map[int]float64{2: 3}},
+		{"late, begun before the flush", 10 * time.Second, 170 * time.Second, map[int]float64{3: 3}},
+	} {
+		for _, output := range stOutputs {
+			got := roundDuringTheFlush(t, output, c.scrapedAt, c.firstAt)
+			t.Run(c.name, func(t *testing.T) { checkMinutes(t, output, got, c.want, 5) })
+		}
+	}
+}
+
+// roundDuringTheFlush pushes the first part of a round scraped at scrapedAt at
+// firstAt, and the rest of it once the next flush has written one output.
+func roundDuringTheFlush(t *testing.T, output string, scrapedAt, firstAt time.Duration) map[string][]outSample {
+	t.Helper()
+	got := map[string][]outSample{}
+	synctest.Test(t, func(t *testing.T) {
+		start := time.Now()
+		var mu sync.Mutex
+		// The hook is in place before the flusher starts and gone after it
+		// stops; armed and pushed are shared with it.
+		var a *Aggregators
+		var armed, pushed atomic.Bool
+		var calls atomic.Int64
+		var scraped int64
+		flushEntryHook = func(*aggregator) {
+			// the second entry of the flush: one output is written, the other not
+			if armed.Load() && calls.Add(1) == 2 && !pushed.Swap(true) {
+				a.Push(prometheus.MustParsePromMetrics(tokensCost(2), scraped), nil)
+			}
+		}
+		defer func() { flushEntryHook = nil }()
+		var err error
+		a, err = LoadFromData([]byte(stConfig(output, "")), func(tss []prompb.TimeSeries) {
+			mu.Lock()
+			defer mu.Unlock()
+			for _, ts := range tss {
+				for _, l := range ts.Labels {
+					if l.Name == "__name__" {
+						for _, s := range ts.Samples {
+							got[l.Value] = append(got[l.Value], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+						}
+					}
+				}
+			}
+		}, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		scraped = start.Add(scrapedAt).UnixMilli()
+		time.Sleep(firstAt)
+		a.Push(prometheus.MustParsePromMetrics(tokensCost(1), scraped), nil)
+		armed.Store(true)
+		time.Sleep(5*time.Minute - time.Since(start))
+		a.MustStop()
+		if !pushed.Load() {
+			t.Fatalf("no flush ran")
+		}
+	})
+	for k := range got {
+		sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+	}
+	return got
+}
+
+// After sum_samples_total starts its total again, as it does before float64
+// loses precision, a tail would be smaller than what was written at its
+// interval and lost to deduplication; it goes to the next interval instead.
+func TestSampleTimestampsTotalTailAfterRestartOfTheTotal(t *testing.T) {
+	big := float64(1 << 53)
+	got := runLateScenario(t, stConfig("sum_samples_total", ""), []latePush{
+		{at: 90 * time.Second, sampleAt: 80 * time.Second, metrics: fmt.Sprintf("tokens %v", big)},
+		{at: 2*time.Minute + 10*time.Second, sampleAt: 80 * time.Second, metrics: `tokens 5`},
+	}, 4*time.Minute)["tokens"]
+	var at2 []float64
+	for _, s := range got {
+		if s.at == 2*time.Minute {
+			at2 = append(at2, s.value)
+		}
+	}
+	if len(at2) != 1 || at2[0] != big {
+		t.Fatalf("want only %v at 2m; got %v", big, got)
+	}
+	if v := got[len(got)-1].value; v != 5 {
+		t.Fatalf("want the total started again at 5 after 2m; got %v", got)
+	}
+}
+
+// Tokens and cost in rules of their own, as the _1m_by_* rules have them: each
+// rule is an aggregator flushing on its own, and one of them can be well into
+// the interval before its flush gets going. A round processed late in that
+// time goes to the same interval in both: where a late round goes follows from
+// when it is processed, decided once for every rule of the interval, not from
+// how far each rule's flush has got.
+func TestSampleTimestampsLateRoundSameIntervalAcrossRules(t *testing.T) {
+	for _, output := range stOutputs {
+		cfg := ""
+		for _, name := range []string{"tokens", "cost"} {
+			cfg += "- match: " + name + "\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+				"  staleness_interval: 40m\n  sample_timestamps: true\n"
+		}
+		got := map[string][]outSample{}
+		synctest.Test(t, func(t *testing.T) {
+			start := time.Now()
+			var mu sync.Mutex
+			var a *Aggregators
+			var held atomic.Bool
+			// The tokens rule's flush at 3m is held for ten seconds before it
+			// writes anything; the cost rule's goes ahead.
+			flushEntryHook = func(ag *aggregator) {
+				if ag == a.as[0] && time.Since(start) >= 3*time.Minute && !held.Swap(true) {
+					time.Sleep(10 * time.Second)
+				}
+			}
+			defer func() { flushEntryHook = nil }()
+			var err error
+			a, err = LoadFromData([]byte(cfg), func(tss []prompb.TimeSeries) {
+				mu.Lock()
+				defer mu.Unlock()
+				for _, ts := range tss {
+					for _, l := range ts.Labels {
+						if l.Name == "__name__" {
+							for _, s := range ts.Samples {
+								got[l.Value] = append(got[l.Value], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+							}
+						}
+					}
+				}
+			}, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			// an ordinary round first, so that both rules have an output to flush
+			time.Sleep(10 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(1), start.Add(5*time.Second).UnixMilli()), nil)
+			time.Sleep(3*time.Minute + 5*time.Second - time.Since(start))
+			if !held.Load() {
+				t.Fatalf("the tokens rule's flush was not held")
+			}
+			// scraped in the minute ending 2m, processed in the one ending 4m
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(5), start.Add(70*time.Second).UnixMilli()), nil)
+			time.Sleep(6 * time.Minute)
+			a.MustStop()
+		})
+		for k := range got {
+			sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+		}
+		checkMinutes(t, output, got, map[int]float64{1: 1, 4: 5}, 8)
+	}
+}
+
+// The tokens and the cost of every round in rules of their own, each flushing
+// at its own pace -- a flush held up for a while before some of its outputs, in
+// one rule and not the other -- and rounds processed up to two and a half
+// minutes late, some while a flush walks the outputs: in every key and interval
+// the cost is three times the tokens, across the two rules, and everything is
+// counted once.
+func TestSampleTimestampsRulesAcrossRules(t *testing.T) {
+	for seed := int64(1); seed <= 20; seed++ {
+		for _, output := range stOutputs {
+			for _, iv := range []time.Duration{time.Minute, 7 * time.Minute} {
+				checkAcrossRules(t, seed, output, iv)
+			}
+		}
+	}
+}
+
+func checkAcrossRules(t *testing.T, seed int64, output string, iv time.Duration) {
+	t.Helper()
+	name := fmt.Sprintf("seed=%d output=%s interval=%s", seed, output, iv)
+	cfg := ""
+	for _, m := range []string{"tokens", "cost"} {
+		cfg += fmt.Sprintf("- match: %s\n  interval: %s\n  by: [key]\n  outputs: [%s]\n  staleness_interval: 2h\n  flush_on_shutdown: true\n  sample_timestamps: true\n", m, iv, output)
+	}
+	rnd := rand.New(rand.NewSource(seed))
+	type push struct {
+		at, sampleAt time.Duration
+		key          int
+		value        float64
+		split        time.Duration // the cost pushed this much after the tokens, 0 for one block
+	}
+	const minutes = 40
+	var pushes []push
+	offsets := []time.Duration{0, time.Millisecond, 13 * time.Second, 37 * time.Second, 59*time.Second + 999*time.Millisecond}
+	for m := 1; m < minutes; m++ {
+		for _, off := range offsets {
+			sampleAt := time.Duration(m)*time.Minute + off
+			delay := time.Duration(1+rnd.Intn(2000)) * time.Millisecond
+			if rnd.Intn(4) == 0 {
+				delay = time.Duration(rnd.Intn(150))*time.Second + time.Duration(1+rnd.Intn(999))*time.Millisecond
+			}
+			// A round is pushed in blocks: often its tokens in one and its cost in
+			// another, seconds later, which a boundary can fall between.
+			split := time.Duration(0)
+			if rnd.Intn(2) == 0 {
+				split = time.Duration(1+rnd.Intn(8000)) * time.Millisecond
+			}
+			pushes = append(pushes, push{at: sampleAt + delay, sampleAt: sampleAt, key: rnd.Intn(3), value: float64(1 + rnd.Intn(9)), split: split})
+		}
+	}
+	sort.SliceStable(pushes, func(i, j int) bool { return pushes[i].at < pushes[j].at })
+	holds := make([]time.Duration, 512) // what each entry flush in turn is held for, by rule
+	for i := range holds {
+		if rnd.Intn(5) == 0 {
+			holds[i] = time.Duration(1+rnd.Intn(30)) * time.Second
+		}
+	}
+
+	got := map[string][]outSample{} // by metric and key
+	var start time.Time
+	synctest.Test(t, func(t *testing.T) {
+		start = time.Now()
+		var mu sync.Mutex
+		var a *Aggregators
+		var calls [2]atomic.Int64
+		flushEntryHook = func(ag *aggregator) {
+			for i := range calls {
+				if ag == a.as[i] {
+					n := calls[i].Add(1)
+					time.Sleep(holds[(int(n)*2+i)%len(holds)])
+				}
+			}
+		}
+		defer func() { flushEntryHook = nil }()
+		var err error
+		a, err = LoadFromData([]byte(cfg), func(tss []prompb.TimeSeries) {
+			mu.Lock()
+			defer mu.Unlock()
+			for _, ts := range tss {
+				var metric, key string
+				for _, l := range ts.Labels {
+					switch l.Name {
+					case "__name__":
+						metric = l.Value
+					case "key":
+						key = l.Value
+					}
+				}
+				if i := strings.IndexByte(metric, ':'); i > 0 {
+					metric = metric[:i]
+				}
+				for _, s := range ts.Samples {
+					got[metric+"/"+key] = append(got[metric+"/"+key], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+				}
+			}
+		}, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		// the pushes in the order they are made, a split round's two blocks apart
+		type block struct {
+			at, sampleAt time.Duration
+			text         string
+		}
+		var blocks []block
+		for _, p := range pushes {
+			tok := fmt.Sprintf("tokens{key=\"k%d\"} %v", p.key, p.value)
+			cost := fmt.Sprintf("cost{key=\"k%d\"} %v", p.key, 3*p.value)
+			if p.split == 0 {
+				blocks = append(blocks, block{p.at, p.sampleAt, tok + "\n" + cost})
+			} else {
+				blocks = append(blocks, block{p.at, p.sampleAt, tok}, block{p.at + p.split, p.sampleAt, cost})
+			}
+		}
+		sort.SliceStable(blocks, func(i, j int) bool { return blocks[i].at < blocks[j].at })
+		for _, b := range blocks {
+			time.Sleep(start.Add(b.at).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(b.text, start.Add(b.sampleAt).UnixMilli()), nil)
+		}
+		time.Sleep(start.Add(minutes*time.Minute + 5*time.Minute).Sub(time.Now()))
+		a.MustStop()
+	})
+	for k := range got {
+		sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+	}
+	all := map[int]float64{}
+	for _, p := range pushes {
+		all[p.key] += p.value
+	}
+	ends := map[time.Duration]bool{}
+	for k := range got {
+		for _, s := range got[k] {
+			ends[s.at.Truncate(time.Second)] = true
+		}
+	}
+	total := func(samples []outSample) float64 {
+		if output == "sum_samples" {
+			return sumIn(samples, -time.Hour, 2*time.Hour)
+		}
+		return increaseIn(samples, -time.Hour, 2*time.Hour)
+	}
+	for key := 0; key < 3; key++ {
+		tok, cost := got[fmt.Sprintf("tokens/k%d", key)], got[fmt.Sprintf("cost/k%d", key)]
+		if tt, cc := total(tok), total(cost); tt != all[key] || cc != 3*all[key] {
+			t.Errorf("%s: key k%d: tokens %v, cost %v; want %v and %v", name, key, tt, cc, all[key], 3*all[key])
+		}
+		for e := range ends {
+			a, b := perInterval(output, tok, e, iv), perInterval(output, cost, e, iv)
+			if b != 3*a {
+				t.Errorf("%s: key k%d: interval ending %s has tokens %v but cost %v: a round was split between the rules", name, key, e, a, b)
+			}
+		}
+		if output == "sum_samples_total" {
+			for _, s := range [][]outSample{tok, cost} {
+				for i := 1; i < len(s); i++ {
+					if s[i].value < s[i-1].value {
+						t.Fatalf("%s: key k%d: the counter goes back from %v to %v", name, key, s[i-1], s[i])
+					}
+				}
+			}
+		}
+	}
+}
+
+// A flush that runs over its interval leaves the next tick waiting, and the
+// flusher goes on with the next boundary right away -- before it is reached. A
+// rule must not take an interval for written before it has ended: a round
+// processed then would be the tail of the interval written last in the other
+// rules and late in this one, two intervals apart.
+func TestSampleTimestampsEarlyFlushStaysBehindTheClock(t *testing.T) {
+	// Aligned to the interval, the flusher drops the tick that waited; not
+	// aligned, it takes it and flushes at once, for a boundary not yet reached.
+	for _, align := range []string{"", "  no_align_flush_to_interval: true\n"} {
+		for _, output := range stOutputs {
+			earlyFlush(t, output, align)
+		}
+	}
+}
+
+func earlyFlush(t *testing.T, output, align string) {
+	t.Helper()
+	{
+		cfg := ""
+		for _, name := range []string{"tokens", "cost"} {
+			cfg += "- match: " + name + "\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+				"  staleness_interval: 40m\n  sample_timestamps: true\n" + align
+		}
+		got := map[string][]outSample{}
+		synctest.Test(t, func(t *testing.T) {
+			start := time.Now()
+			var mu sync.Mutex
+			var a *Aggregators
+			var held atomic.Bool
+			// The tokens rule's flush at 1m takes 90 seconds; the one at 2m then
+			// runs as soon as it is done, at 2m30s, for the boundary at 3m.
+			flushEntryHook = func(ag *aggregator) {
+				if ag == a.as[0] && !held.Swap(true) {
+					time.Sleep(90 * time.Second)
+				}
+			}
+			defer func() { flushEntryHook = nil }()
+			var err error
+			a, err = LoadFromData([]byte(cfg), func(tss []prompb.TimeSeries) {
+				mu.Lock()
+				defer mu.Unlock()
+				for _, ts := range tss {
+					for _, l := range ts.Labels {
+						if l.Name == "__name__" {
+							for _, s := range ts.Samples {
+								got[l.Value] = append(got[l.Value], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+							}
+						}
+					}
+				}
+			}, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			time.Sleep(10 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(1), start.Add(5*time.Second).UnixMilli()), nil)
+			// a round of the minute ending 3m, before the early flush
+			time.Sleep(140*time.Second - time.Since(start))
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(2), start.Add(135*time.Second).UnixMilli()), nil)
+			// a round scraped in the minute ending 2m, processed at 2m40s, after its
+			// minute ended: the minute it is processed in, in every rule
+			time.Sleep(160*time.Second - time.Since(start))
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(5), start.Add(110*time.Second).UnixMilli()), nil)
+			time.Sleep(7*time.Minute - time.Since(start))
+			a.MustStop()
+		})
+		for k := range got {
+			sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+		}
+		checkMinutes(t, output, got, map[int]float64{1: 1, 3: 2 + 5}, 7)
+		for _, s := range got["tokens"] {
+			if s.at%time.Minute != 0 {
+				t.Errorf("%s %q: %v written inside an interval, before it ended", output, align, s)
+			}
+		}
+	}
+}
+
+// A round whose interval has ended by the time it is processed, its tokens in
+// one block before a boundary and its cost in another after it, in rules of
+// their own: the round goes whole to one interval. Its interval is decided at
+// its first block and kept for the rest, rather than the first block being the
+// tail of its own interval and the second, a boundary later, late.
+func TestSampleTimestampsRoundInBlocksAcrossABoundary(t *testing.T) {
+	for _, output := range stOutputs {
+		cfg := ""
+		for _, name := range []string{"tokens", "cost"} {
+			cfg += "- match: " + name + "\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+				"  staleness_interval: 40m\n  sample_timestamps: true\n"
+		}
+		scraped := 70 * time.Second // in the minute ending 2m
+		got := runLateScenario(t, cfg, []latePush{
+			{at: 10 * time.Second, sampleAt: 5 * time.Second, metrics: tokensCost(1)},
+			{at: 150 * time.Second, sampleAt: scraped, metrics: `tokens 5`},
+			{at: 185 * time.Second, sampleAt: scraped, metrics: `cost 15`},
+		}, 6*time.Minute)
+		checkMinutes(t, output, got, map[int]float64{1: 1, 3: 5}, 6)
+	}
+}
+
+// A push decided before a flush and adding to an output after the flush has
+// written it -- a boundary between the two -- is taken for one decided after:
+// the flush waits for the pushes in progress. And every rule places a push by
+// the same reading of the clock, however long the push takes to go from one
+// rule to the next.
+func TestSampleTimestampsPushAcrossTheFlush(t *testing.T) {
+	for _, output := range stOutputs {
+		cfg := ""
+		for _, name := range []string{"tokens", "cost"} {
+			cfg += "- match: " + name + "\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+				"  staleness_interval: 40m\n  sample_timestamps: true\n"
+		}
+		got := map[string][]outSample{}
+		synctest.Test(t, func(t *testing.T) {
+			start := time.Now()
+			var mu sync.Mutex
+			var a *Aggregators
+			var holdPush, holdFlush atomic.Bool
+			// The push is held for five seconds in the tokens rule, after it has
+			// been placed, from just before the boundary at 3m to after it; the
+			// cost rule's flush at 3m is held for ten.
+			pushHook = func(ag *aggregator) {
+				if ag == a.as[0] && holdPush.Load() && holdPush.CompareAndSwap(true, false) {
+					time.Sleep(5 * time.Second)
+				}
+			}
+			flushEntryHook = func(ag *aggregator) {
+				if ag == a.as[1] && time.Since(start) >= 3*time.Minute && !holdFlush.Swap(true) {
+					time.Sleep(10 * time.Second)
+				}
+			}
+			defer func() { pushHook, flushEntryHook = nil, nil }()
+			var err error
+			a, err = LoadFromData([]byte(cfg), func(tss []prompb.TimeSeries) {
+				mu.Lock()
+				defer mu.Unlock()
+				for _, ts := range tss {
+					for _, l := range ts.Labels {
+						if l.Name == "__name__" {
+							for _, s := range ts.Samples {
+								got[l.Value] = append(got[l.Value], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+							}
+						}
+					}
+				}
+			}, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			scraped := start.Add(100 * time.Second).UnixMilli() // in the minute ending 2m
+			time.Sleep(110 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(1), scraped), nil)
+			// the rest of the round, a millisecond before the boundary at 3m
+			time.Sleep(3*time.Minute - time.Millisecond - time.Since(start))
+			holdPush.Store(true)
+			a.Push(prometheus.MustParsePromMetrics(tokensCost(2), scraped), nil)
+			time.Sleep(6*time.Minute - time.Since(start))
+			a.MustStop()
+		})
+		for k := range got {
+			sort.SliceStable(got[k], func(i, j int) bool { return got[k][i].at < got[k][j].at })
+		}
+		checkMinutes(t, output, got, map[int]float64{2: 3}, 6)
+	}
+}
diff --git a/lib/streamaggr/sample_timestamps_test.go b/lib/streamaggr/sample_timestamps_test.go
new file mode 100644
index 000000000..e7ea461dc
--- /dev/null
+++ b/lib/streamaggr/sample_timestamps_test.go
@@ -0,0 +1,348 @@
+package streamaggr
+
+import (
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/prompb"
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/protoparser/prometheus"
+)
+
+// latePush is a push made at wall time at of samples scraped at sampleAt, both
+// relative to the start; an aggregator that has fallen behind makes them apart.
+type latePush struct {
+	at, sampleAt time.Duration
+	metrics      string
+}
+
+type outSample struct {
+	at    time.Duration // the output timestamp relative to the start
+	value float64
+}
+
+// runLateScenario feeds pushes to the aggregators in config under a fake clock
+// that starts on a minute and returns their output samples by metric name, in
+// timestamp order.
+func runLateScenario(t *testing.T, config string, pushes []latePush, until time.Duration) map[string][]outSample {
+	t.Helper()
+	out := map[string][]outSample{}
+	synctest.Test(t, func(t *testing.T) {
+		var mu sync.Mutex
+		var tss []prompb.TimeSeries
+		pushFunc := func(src []prompb.TimeSeries) {
+			mu.Lock()
+			tss = appendClonedTimeseries(tss, src)
+			mu.Unlock()
+		}
+		a, err := LoadFromData([]byte(config), pushFunc, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		start := time.Now()
+		for _, p := range pushes {
+			time.Sleep(start.Add(p.at).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(p.metrics, start.Add(p.sampleAt).UnixMilli()), nil)
+		}
+		time.Sleep(start.Add(until).Sub(time.Now()))
+		a.MustStop()
+
+		mu.Lock()
+		defer mu.Unlock()
+		for _, ts := range tss {
+			name := ""
+			for _, l := range ts.Labels {
+				if l.Name == "__name__" {
+					name = l.Value
+				}
+			}
+			for _, s := range ts.Samples {
+				out[name] = append(out[name], outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+			}
+		}
+		for name := range out {
+			sort.SliceStable(out[name], func(i, j int) bool { return out[name][i].at < out[name][j].at })
+		}
+	})
+	return out
+}
+
+// sumIn adds up the samples within (from, to], as sum_over_time() does after
+// VM's deduplication has kept the biggest of the samples sharing a timestamp.
+func sumIn(samples []outSample, from, to time.Duration) float64 {
+	kept := map[time.Duration]float64{}
+	for _, s := range samples {
+		if v, ok := kept[s.at]; s.at > from && s.at <= to && (!ok || s.value > v) {
+			kept[s.at] = s.value
+		}
+	}
+	var sum float64
+	for _, v := range kept {
+		sum += v
+	}
+	return sum
+}
+
+// increaseIn is the increase of a counter over (from, to]: the last value at or
+// before to minus the last value at or before from. VM keeps the biggest of
+// samples sharing a timestamp, and so does this.
+func increaseIn(samples []outSample, from, to time.Duration) float64 {
+	last := func(at time.Duration) float64 {
+		var v float64
+		lastAt, found := time.Duration(0), false
+		for _, s := range samples {
+			if s.at > at {
+				break
+			}
+			if !found || s.at > lastAt || s.value > v {
+				v, lastAt, found = s.value, s.at, true
+			}
+		}
+		return v
+	}
+	return last(to) - last(from)
+}
+
+// One target's round 2 is processed after round 3 was written. It cannot be
+// written at 2m, after 3m in the series: the counter would go back. It goes to
+// 3m, off by the gap between the two targets rather than lost or misplaced.
+func TestSampleTimestampsTotalNeverGoesBack(t *testing.T) {
+	cfg := "- match: foo\n  interval: 1m\n  outputs: [sum_samples_total]\n  keep_metric_names: true\n" +
+		"  staleness_interval: 40m\n  sample_timestamps: true\n"
+	pushes := []latePush{
+		{at: 3*time.Minute + 10*time.Second, sampleAt: 3 * time.Minute, metrics: `foo 1`},
+		{at: 4*time.Minute + 30*time.Second, sampleAt: 2 * time.Minute, metrics: `foo 1`},
+	}
+	got := runLateScenario(t, cfg, pushes, 6*time.Minute)["foo"]
+	for i := 1; i < len(got); i++ {
+		if got[i].value < got[i-1].value {
+			t.Fatalf("the counter goes back from %v to %v: %v", got[i-1], got[i], got)
+		}
+	}
+	if inc := increaseIn(got, 0, 6*time.Minute); inc != 2 {
+		t.Fatalf("increase is %v, want 2; samples %v", inc, got)
+	}
+}
+
+func TestSampleTimestampsRefusesWhatItCannotDo(t *testing.T) {
+	for _, cfg := range []string{
+		"- match: foo\n  interval: 1m\n  outputs: [total]\n  sample_timestamps: true\n",
+		"- match: foo\n  interval: 1m\n  outputs: [sum_samples, max]\n  sample_timestamps: true\n",
+		"- match: foo\n  interval: 1m\n  dedup_interval: 30s\n  outputs: [sum_samples]\n  sample_timestamps: true\n",
+		"- match: foo\n  interval: 1m\n  enable_windows: true\n  outputs: [sum_samples]\n  sample_timestamps: true\n",
+		"- match: foo\n  interval: 1m\n  ignore_old_samples: true\n  outputs: [sum_samples]\n  sample_timestamps: true\n",
+	} {
+		a, err := LoadFromData([]byte(cfg), func([]prompb.TimeSeries) {}, nil, "test")
+		if err == nil {
+			a.MustStop()
+			t.Errorf("accepted %q", strings.ReplaceAll(cfg, "\n", " "))
+		}
+	}
+}
+
+// The global option is one flag over a whole config: it leaves alone the
+// aggregations it cannot apply to, such as a gauge de-duplicated per interval,
+// and takes the rest.
+func TestSampleTimestampsGlobalOptionSkipsWhatItCannotApplyTo(t *testing.T) {
+	cfg := "- match: foo\n  interval: 1m\n  outputs: [sum_samples_total]\n" +
+		"- match: bar\n  interval: 1m\n  dedup_interval: 60s\n  outputs: [sum_samples]\n" +
+		"- match: baz\n  interval: 1m\n  outputs: [max]\n"
+	a, err := LoadFromData([]byte(cfg), func([]prompb.TimeSeries) {}, &Options{SampleTimestamps: true}, "test")
+	if err != nil {
+		t.Fatalf("the global option refused the config: %s", err)
+	}
+	defer a.MustStop()
+	for i, want := range []bool{true, false, false} {
+		if got := a.as[i].sampleTimestamps; got != want {
+			t.Errorf("aggregation %d: sample timestamps %v, want %v", i, got, want)
+		}
+	}
+}
+
+// A flush that runs a little after its boundary finds samples scraped after the
+// boundary, of the interval still open. They must not be written into the
+// interval that just closed, and not twice.
+func TestSampleTimestampsOpenIntervalStaysOpen(t *testing.T) {
+	for _, output := range []string{"sum_samples", "sum_samples_total"} {
+		cfg := "- match: foo\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+			"  staleness_interval: 40m\n  sample_timestamps: true\n"
+		var got []outSample
+		synctest.Test(t, func(t *testing.T) {
+			start := time.Now()
+			var mu sync.Mutex
+			pushFunc := func(tss []prompb.TimeSeries) {
+				mu.Lock()
+				defer mu.Unlock()
+				for _, ts := range tss {
+					for _, s := range ts.Samples {
+						got = append(got, outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+					}
+				}
+			}
+			a, err := LoadFromData([]byte(cfg), pushFunc, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			aggr := a.as[0]
+			T := start.Add(time.Minute)
+			time.Sleep(T.Add(-10 * time.Second).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(`foo 1`, T.Add(-10*time.Second).UnixMilli()), nil)
+			// The flush for T runs 20ms late, and a round scraped 5ms after T is
+			// already in.
+			time.Sleep(T.Add(5 * time.Millisecond).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(`foo 10`, T.Add(5*time.Millisecond).UnixMilli()), nil)
+			time.Sleep(T.Add(20 * time.Millisecond).Sub(time.Now()))
+			aggr.flush(pushFunc, T, aggr.cs.Load(), false)
+			time.Sleep(start.Add(3 * time.Minute).Sub(time.Now()))
+			a.MustStop()
+		})
+		sort.SliceStable(got, func(i, j int) bool { return got[i].at < got[j].at })
+		first, second := sumIn(got, 0, time.Minute), sumIn(got, time.Minute, 2*time.Minute)
+		if output == "sum_samples_total" {
+			first, second = increaseIn(got, -time.Minute, time.Minute), increaseIn(got, time.Minute, 2*time.Minute)
+		}
+		if first != 1 || second != 10 {
+			t.Errorf("%s: minute 1 got %v, want 1; minute 2 got %v, want 10; samples %v", output, first, second, got)
+		}
+		// Left for the next flush, the open interval is written at its end.
+		for _, s := range got {
+			if s.at > time.Minute && s.at < 2*time.Minute-time.Second {
+				t.Errorf("%s: sample %v of minute 2 was written before minute 2 ended; samples %v", output, s, got)
+			}
+		}
+	}
+}
+
+// The flush on shutdown writes the interval still open, before it ends, at the
+// time of the shutdown. Right after a boundary that is still in the open
+// interval, not in the one just closed.
+func TestSampleTimestampsShutdownRightAfterBoundary(t *testing.T) {
+	cfg := "- match: foo\n  interval: 1m\n  outputs: [sum_samples]\n  keep_metric_names: true\n" +
+		"  flush_on_shutdown: true\n  sample_timestamps: true\n"
+	var got []outSample
+	synctest.Test(t, func(t *testing.T) {
+		start := time.Now()
+		var mu sync.Mutex
+		a, err := LoadFromData([]byte(cfg), func(tss []prompb.TimeSeries) {
+			mu.Lock()
+			defer mu.Unlock()
+			for _, ts := range tss {
+				for _, s := range ts.Samples {
+					got = append(got, outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+				}
+			}
+		}, nil, "test")
+		if err != nil {
+			t.Fatalf("cannot load config: %s", err)
+		}
+		T := start.Add(time.Minute)
+		time.Sleep(T.Add(2 * time.Millisecond).Sub(time.Now()))
+		a.Push(prometheus.MustParsePromMetrics(`foo 10`, T.Add(time.Millisecond).UnixMilli()), nil)
+		time.Sleep(T.Add(5 * time.Millisecond).Sub(time.Now()))
+		a.MustStop()
+	})
+	if sum := sumIn(got, time.Minute, 2*time.Minute); sum != 10 || len(got) != 1 {
+		t.Fatalf("want 10 written once within minute 2; samples %v", got)
+	}
+}
+
+// A flush that takes longer than its interval reaches some entries only after
+// the next interval has started, or ended: such an entry holds samples of the
+// interval right after the boundary and of the one after that. Neither may be
+// written ahead of the other, or sum_samples_total, which never writes a
+// timestamp before one it has written, would move the first into the second.
+func TestSampleTimestampsFlushLongerThanInterval(t *testing.T) {
+	for _, output := range []string{"sum_samples", "sum_samples_total"} {
+		cfg := "- match: '{__name__=~\"foo|bar\"}'\n  interval: 1m\n  outputs: [" + output + "]\n  keep_metric_names: true\n" +
+			"  staleness_interval: 40m\n  sample_timestamps: true\n"
+		var got []outSample
+		synctest.Test(t, func(t *testing.T) {
+			start := time.Now()
+			F := start.Add(time.Minute)
+			var mu sync.Mutex
+			pushFunc := func(tss []prompb.TimeSeries) {
+				stuck := false
+				mu.Lock()
+				for _, ts := range tss {
+					if ts.Labels[0].Value == "bar" || (len(ts.Labels) > 1 && ts.Labels[1].Value == "bar") {
+						stuck = true
+						continue
+					}
+					for _, s := range ts.Samples {
+						got = append(got, outSample{time.UnixMilli(s.Timestamp).Sub(start), s.Value})
+					}
+				}
+				mu.Unlock()
+				if stuck && time.Now().Before(F.Add(time.Second)) {
+					// The background flush at F is stuck for 200 seconds, as
+					// a flush walking a million entries would be.
+					time.Sleep(200 * time.Second)
+				}
+			}
+			a, err := LoadFromData([]byte(cfg), pushFunc, nil, "test")
+			if err != nil {
+				t.Fatalf("cannot load config: %s", err)
+			}
+			aggr := a.as[0]
+			time.Sleep(F.Add(-30 * time.Second).Sub(time.Now()))
+			a.Push(prometheus.MustParsePromMetrics(`bar 1`, F.Add(-30*time.Second).UnixMilli()), nil)
+			at := func(d time.Duration) { time.Sleep(F.Add(d).Sub(time.Now())) }
+			at(30 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(`foo 1`, F.Add(30*time.Second).UnixMilli()), nil)
+			at(70 * time.Second)
+			a.Push(prometheus.MustParsePromMetrics(`foo 10`, F.Add(70*time.Second).UnixMilli()), nil)
+			// The stuck flush for F reaches foo's entry 90 seconds late.
+			at(90 * time.Second)
+			aggr.flush(pushFunc, F, aggr.cs.Load(), false)
+			// The next flush to run is for F+2m.
+			at(120 * time.Second)
+			aggr.flush(pushFunc, F.Add(2*time.Minute), aggr.cs.Load(), false)
+			at(10 * time.Minute)
+			a.MustStop()
+		})
+		sort.SliceStable(got, func(i, j int) bool { return got[i].at < got[j].at })
+		var m2, m3 float64
+		if output == "sum_samples" {
+			m2, m3 = sumIn(got, time.Minute, 2*time.Minute), sumIn(got, 2*time.Minute, 3*time.Minute)
+		} else {
+			m2, m3 = increaseIn(got, time.Minute, 2*time.Minute), increaseIn(got, 2*time.Minute, 3*time.Minute)
+		}
+		if m2 != 1 || m3 != 10 {
+			t.Errorf("%s: minute 2 got %v, want 1; minute 3 got %v, want 10; samples %v", output, m2, m3, got)
+		}
+	}
+}
+
+// A round that arrives after a later interval was written goes to a later
+// interval than its own, and every output of the aggregator has to put it in the
+// same one. Here a free request in minute 3 moved the tokens on but not the cost,
+// whose heartbeat is not due, so by its own latest point the cost of minute 1's
+// late round would go back into minute 1 while its tokens went to minute 3: the
+// two would be over in one minute and short in the other, and so in their hours.
+func TestSampleTimestampsTotalLateRoundLandsTogether(t *testing.T) {
+	cfg := "- match: '{__name__=~\"tokens|cost\"}'\n  interval: 1m\n  outputs: [sum_samples_total]\n  keep_metric_names: true\n" +
+		"  staleness_interval: 40m\n  output_heartbeat_interval: 4m\n  sample_timestamps: true\n"
+	pushes := []latePush{
+		{at: 30 * time.Second, sampleAt: 30 * time.Second, metrics: "tokens 10\ncost 30"},
+		{at: 150 * time.Second, sampleAt: 150 * time.Second, metrics: "tokens 5\ncost 0"}, // a free request
+		{at: 190 * time.Second, sampleAt: 40 * time.Second, metrics: "tokens 1\ncost 3"},  // minute 1's, late
+		{at: 250 * time.Second, sampleAt: 250 * time.Second, metrics: "tokens 2\ncost 6"}, // minute 5
+	}
+	got := runLateScenario(t, cfg, pushes, 8*time.Minute)
+	// cost - 3*tokens of the requests in each minute: the free one's -15, and the
+	// late round with it, whole
+	for m, want := range map[int]float64{1: 0, 2: 0, 3: -15, 4: 0, 5: 0} {
+		from, to := time.Duration(m-1)*time.Minute, time.Duration(m)*time.Minute
+		tok, cost := increaseIn(got["tokens"], from, to), increaseIn(got["cost"], from, to)
+		if d := cost - 3*tok; d != want {
+			t.Errorf("minute %d: tokens %v, cost %v: cost - 3*tokens = %v, want %v; tokens %v, cost %v",
+				m, tok, cost, d, want, got["tokens"], got["cost"])
+		}
+	}
+	if tok, cost := increaseIn(got["tokens"], 0, 8*time.Minute), increaseIn(got["cost"], 0, 8*time.Minute); tok != 18 || cost != 39 {
+		t.Errorf("in all: tokens %v, cost %v; want 18 and 39", tok, cost)
+	}
+}
diff --git a/lib/streamaggr/sample_timestamps_timing_test.go b/lib/streamaggr/sample_timestamps_timing_test.go
new file mode 100644
index 000000000..7b957c272
--- /dev/null
+++ b/lib/streamaggr/sample_timestamps_timing_test.go
@@ -0,0 +1,90 @@
+package streamaggr
+
+import (
+	"fmt"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/VictoriaMetrics/VictoriaMetrics/lib/prompb"
+)
+
+// The ACG shape under sample_timestamps: every output is fed by many targets,
+// and vmagent scrapes each target at an offset of its own, so the rounds of one
+// minute reach an output with as many distinct timestamps as there are targets.
+// lag is how many minutes of rounds pile up between two flushes, as while
+// vmagent is behind.
+func BenchmarkSampleTimestampsManyTargets(b *testing.B) {
+	const (
+		targets = 20
+		keys    = 2000
+	)
+	for _, lag := range []int{1, 4} {
+		for _, mode := range []string{"off", "on"} {
+			b.Run(fmt.Sprintf("lag=%dm/sample_timestamps=%s", lag, mode), func(b *testing.B) {
+				config := `
+- match: acg_cost_total
+  interval: 1m
+  by: [apikey_id]
