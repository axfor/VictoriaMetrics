+func (av *aggrValues) outputs(n int, isGreen bool) []aggrValue {
+	if av.more == nil {
+		if isGreen {
+			return nil
+		}
+		return av.one[:]
+	}
+	all := *av.more
+	if isGreen {
+		if len(all) < 2*n {
+			return nil
+		}
+		return all[n : 2*n]
+	}
+	return all[:n]
