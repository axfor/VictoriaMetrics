++// resolveEncoderConcurrency is the flag, or the library's own default when it
++// is unset or nonsense.
++func resolveEncoderConcurrency() int {
++	if n := *encoderConcurrency; n > 0 {
++		return n
++	}
++	return runtime.GOMAXPROCS(0)
++}
