+++func TestClientReadDataContentEncoding(t *testing.T) {
+++	body := testScrapeBody()
+++
+++	f := func(zstdEnabled bool, respEncoding, wantAcceptEncoding, wantContentEncoding string) {
+++		t.Helper()
+++
+++		origZstd := *zstdCompression
+++		*zstdCompression = zstdEnabled
