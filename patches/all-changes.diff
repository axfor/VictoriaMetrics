+++	sw.Config = cfg
+++	sw.ReadData = func(dst *chunkedbuffer.Buffer) (string, error) {
+++		dst.MustWrite(compressed)
+++		return contentEncoding, nil
+++	}
+++	sw.PushData = ps.push
+++	tsmGlobal.Register(&sw)
+++	defer tsmGlobal.Unregister(&sw)
+++	err := sw.scrapeInternal(123000, 123000)
+++	return ps, err
+++}
