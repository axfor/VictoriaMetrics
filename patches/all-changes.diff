+		{"two-same-name", rule("m0", "job") + rule("m0", "instance"), 20},
+		{"two-same-name-all-match", rule("m0", "job") + rule("m0", "instance"), 1},
+		{"two-names", rule("m0", "job") + rule("m1", "job"), 20},
+		{"two-names-interleaved", rule("m0", "job") + rule("m1", "job"), -2},
