++	for _, output := range []string{"sum_samples_total", "sum_samples"} {
++		b.Run("output="+output, func(b *testing.B) {
++			config := fmt.Sprintf(`
++- match: http_requests_total
++  interval: 24h
++  drop_input_labels: [pod, instance, node]
++  outputs: [%s]
++  keep_metric_names: true
