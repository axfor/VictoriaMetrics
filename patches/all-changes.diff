+++		{"quantiles(0.5)", false},
+++		{"stddev", false},
+++		{"stdvar", false},
+++		{"sum_samples", false},
+++		{"sum_samples_total", false},
+++		{"unique_samples", false},
+++	} {
+++		t.Run(tc.output, func(t *testing.T) {
+++			ac, err := newOutputConfig(tc.output, map[string]struct{}{}, false, 0)
+++			if err != nil {
