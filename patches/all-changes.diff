+// newAggrValues builds the entry for a new output series.
+func (ao *aggrOutputs) newAggrValues() *aggrValues {
+	nv := &aggrValues{}
+	n := len(ao.configs)
+	if n == 1 && !ao.useSharedState {
+		nv.one[0] = ao.configs[0].getValue(nil)
+		return nv
+	}
+	size := n
+	if ao.useSharedState {
+		size = 2 * n
+	}
+	all := make([]aggrValue, size)
