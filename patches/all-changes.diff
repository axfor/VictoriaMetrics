++				b.Fatalf("cannot load config: %s", err)
++			}
++			defer a.MustStop()
++
++			const loops = 100
++			b.ResetTimer()
++			b.ReportAllocs()
++			b.SetBytes(int64(len(benchSeries) * loops))
++			b.RunParallel(func(pb *testing.PB) {
++				var matchIdxs []byte
++				for pb.Next() {
++					for i := 0; i < loops; i++ {
++						matchIdxs = a.Push(benchSeries, matchIdxs)
++					}
++				}
++			})
++		})
++	}
++}
