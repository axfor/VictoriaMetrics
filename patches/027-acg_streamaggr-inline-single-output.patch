 			sh.mu.Lock()
 			if sh.m == nil {
@@ -123,11 +112,7 @@ func (ao *aggrOutputs) pushSamples(samples []pushSample, deleteDeadline int64, i
 		av.mu.Lock()
 		deleted := av.deleteDeadline < 0
 		if !deleted {
-			if isGreen {
-				outputs = av.green
-			} else {
-				outputs = av.blue
