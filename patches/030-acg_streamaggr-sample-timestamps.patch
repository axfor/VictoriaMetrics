+	if p.more == nil {
+		f(p.ts, p.sum)
+		p.ts, p.sum = 0, 0
+		return
+	}
+	all := append(*p.more, tsSum{p.ts, p.sum})
+	slices.SortFunc(all, func(a, b tsSum) int { return cmp.Compare(a.ts, b.ts) })
+	for _, x := range all {
+		f(x.ts, x.sum)
+	}
