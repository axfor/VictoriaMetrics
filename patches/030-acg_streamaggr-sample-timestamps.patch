+}
+
+type tsSum struct {
+	ts  int64
+	sum float64
+}
+
+func (p *bySampleTime) add(ts int64, v float64) {
+	switch {
+	case p.ts == 0:
+		p.ts, p.sum = ts, v
+	case p.ts == ts:
+		p.sum += v
+	default:
+		if p.more == nil {
+			p.more = &[]tsSum{}
+		}
+		for i := range *p.more {
+			if (*p.more)[i].ts == ts {
+				(*p.more)[i].sum += v
+				return
+			}
+		}
+		*p.more = append(*p.more, tsSum{ts, v})
+	}
