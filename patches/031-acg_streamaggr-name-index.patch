@@ -353,14 +361,50 @@ func loadFromData(data []byte, filePath string, pushFunc PushFunc, opts *Options
 	}
 
 	metrics.RegisterSet(ms)
+	byName, indexed, unindexed := indexAggregatorsByName(as)
 	return &Aggregators{
 		as:         as,
+		byName:     byName,
