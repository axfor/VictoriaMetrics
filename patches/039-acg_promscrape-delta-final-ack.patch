 lib/promscrape/delta_ack_test.go | 103 +++++++++++++++++++++++++++++++
 lib/promscrape/scraper.go        |   4 ++
 lib/promscrape/scrapework.go     |  54 +++++++++++++++-
 4 files changed, 210 insertions(+), 5 deletions(-)

