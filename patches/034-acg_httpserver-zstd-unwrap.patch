From 8ec2f7033d888e9053b059e20ba41705d3535707 Mon Sep 17 00:00:00 2001
From: axfor <aixiaoxiang2009@hotmail.com>
Date: Thu, 22 Oct 2026 21:09:09 -0700
Subject: [PATCH 31/40] lib/httpserver: let the zstd response writer be
 unwrapped

http.NewResponseController reaches what a wrapper does not implement,
such as write deadlines, through Unwrap. The gzip wrapper has it and the
zstd one did not, so a handler setting a write deadline would fail only
for clients preferring zstd. Nothing in VictoriaMetrics does that today.
---
 lib/httpserver/zstd.go      |  7 +++++++
 lib/httpserver/zstd_test.go | 25 +++++++++++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/lib/httpserver/zstd.go b/lib/httpserver/zstd.go
index 4b1997980..cda9c880d 100644
--- a/lib/httpserver/zstd.go
+++ b/lib/httpserver/zstd.go
@@ -205,6 +205,13 @@ func (zw *zstdResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
 	return hj.Hijack()
 }
 
+// Unwrap returns the wrapped ResponseWriter, so that http.NewResponseController
+// reaches what it does not implement itself, such as write deadlines, as it does
+// through the gzip wrapper.
+func (zw *zstdResponseWriter) Unwrap() http.ResponseWriter {
+	return zw.ResponseWriter
+}
+
 func (zw *zstdResponseWriter) close() {
 	if !zw.hijacked {
 		if !zw.decided {
diff --git a/lib/httpserver/zstd_test.go b/lib/httpserver/zstd_test.go
index 1f8162394..fc5f8d531 100644
--- a/lib/httpserver/zstd_test.go
+++ b/lib/httpserver/zstd_test.go
@@ -358,3 +358,28 @@ func TestTheWindowIsSmall(t *testing.T) {
 		t.Fatalf("window %d bytes (%v), want at most 1 MiB", h.WindowSize, err)
 	}
 }
+
+// http.NewResponseController reaches the server's writer through the zstd
+// wrapper, as it does through the gzip one: a handler setting a write deadline
+// must not fail only for clients preferring zstd.
+func TestZstdResponseWriterUnwrap(t *testing.T) {
+	var deadlineErr error
+	h := compressHandlerWrapper(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		deadlineErr = http.NewResponseController(w).SetWriteDeadline(time.Now().Add(time.Minute))
+		_, _ = w.Write([]byte("ok"))
+	}))
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	for _, enc := range []string{"zstd", "gzip"} {
+		req, _ := http.NewRequest("GET", srv.URL, nil)
+		req.Header.Set("Accept-Encoding", enc)
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatalf("%s: %s", enc, err)
+		}
+		_ = resp.Body.Close()
+		if deadlineErr != nil {
+			t.Fatalf("%s: cannot set a write deadline through the wrapper: %s", enc, deadlineErr)
+		}
+	}
+}
